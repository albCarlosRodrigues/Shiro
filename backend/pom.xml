<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.squaddesktop</groupId>
    <artifactId>squad-desktop-backend</artifactId>
    <version>0.1.1</version>
    <name>Squad Desktop - backend</name>
    <description>Serviço local do Squad Desktop: regras de negócio, orquestração, persistência e execução do Claude Code.</description>

    <properties>
        <!-- Java 21 LTS como base: compila e roda também no Java 25 LTS. -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Driver JDBC do SQLite; a versão vem do gerenciamento de dependências do Spring Boot. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>squad-desktop-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- O driver do SQLite carrega uma biblioteca nativa; evita o aviso de acesso nativo no Java 24+. -->
                    <argLine>--enable-native-access=ALL-UNNAMED -Dfile.encoding=UTF-8</argLine>
                    <environmentVariables>
                        <!-- Caminhos com acentos nos testes também em máquinas Linux com locale POSIX. -->
                        <LANG>C.UTF-8</LANG>
                        <LC_ALL>C.UTF-8</LC_ALL>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
